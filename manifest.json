{
  "manifest_version": 3,
  "name": "新北再生家具競標管理工具",
  "version": "4.3.0",
  "description": "新北市再生家具拍賣網進階管理工具 - 現代扁平風 UI、統計分析、列印表格、批次操作、JSON 匯入匯出",
  "icons": {
    "128": "icon.png"
  },
  "host_permissions": [
    "https://recycledstuff.ntpc.gov.tw/BidMgr/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://recycledstuff.ntpc.gov.tw/BidMgr/*"],
      "js": [
        "state/appState.js",
        "config/constants.js",
        "config/mappings.js",
        "ui/styles.js",
        "ui/notifications.js",
        "core/errorHandler.js",
        "state/itemStatus.js",
        "state/bidStatus.js",
        "utils/scroll.js",
        "utils/image.js",
        "utils/csv.js",
        "utils/api.js",
        "utils/sheetSync.js",
        "ui/components/statsModal.js",
        "ui/components/photoPreview.js",
        "ui/components/importModal.js",
        "ui/components/deleteModal.js",
        "ui/components/settingsPanel.js",
        "ui/components/dataPanel.js",
        "ui/buttons.js",
        "core/messageHandler.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://recycledstuff.ntpc.gov.tw/*"]
    }
  ]
}